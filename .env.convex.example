# ===========================================================================
# Variables d'environnement cote Convex
# ---------------------------------------------------------------------------
# Copier ce fichier vers .env.convex et remplir uniquement les vars necessaires
# selon les integrations activees pour le client.
#
# Puis lancer:
#   bash scripts/setup-convex-env.sh
#
# Le fichier .env.convex est dans .gitignore (ne PAS commiter).
# ===========================================================================

# --- REQUIS ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- AWS (uploads + emails) ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_SES_FROM_EMAIL=

# --- OpenAI (traduction auto) ---
OPENAI_API_KEY=

# --- Encryption (paymentConnections POS) ---
# generer: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Stripe SaaS BID ---
STRIPE_BID_SECRET_KEY=
STRIPE_BID_WEBHOOK_SECRET=
STRIPE_BID_PRICE_STARTER=
STRIPE_BID_PRICE_PRO=
STRIPE_BID_PRICE_ENTERPRISE=
STRIPE_BID_PRICE_STARTER_ANNUAL=
STRIPE_BID_PRICE_PRO_ANNUAL=
STRIPE_BID_PRICE_ENTERPRISE_ANNUAL=
BID_APP_URL=

# --- Stripe restaurant ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Uber Eats ---
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
UBER_EATS_WEBHOOK_SECRET=
UBER_EATS_SANDBOX_MODE=true

# --- Deliveroo ---
DELIVEROO_BRAND_ID=
DELIVEROO_SITE_ID=
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=
DELIVEROO_IS_SANDBOX=true

# --- Facebook OAuth ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Unsplash (CMS medias) ---
UNSPLASH_ACCESS_KEY=
