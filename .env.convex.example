# ===========================================================================
# Variables d'environnement côté CONVEX (fonctions backend)
# ---------------------------------------------------------------------------
# Copier vers .env.convex, remplir uniquement les intégrations actives pour
# ce client, puis appliquer en bulk :
#
#   pnpm convex:env        # = bash scripts/setup-convex-env.sh
#
# .env.convex est gitignoré — ne JAMAIS le commiter.
# Ces variables se lisent/écrivent aussi via `pnpx convex env list|set`.
#
# Les blocs « REQUIS » sont ceux que le moteur exige au démarrage de l'app
# Next (validateAllEnv, via instrumentation.ts) ET que les actions Convex
# lisent ici. Côté Convex la lecture reste permissive : une variable absente
# ne bloque pas le déploiement, elle fait échouer l'action au moment où un
# client s'en sert. D'où le commentaire « sans elle : … » sur chaque ligne.
# ===========================================================================

# DEUX MOITIÉS, DEUX PROPRIÉTAIRES
# Les blocs marqués « ⇢ BeYours » ci-dessous ne vous appartiennent pas : ce
# sont les identifiants de la plateforme, identiques sur TOUS les déploiements
# clients. Ils ont une source unique (Infisical) et arrivent ici avec :
#
#   pnpm convex:env:infisical
#
# Tout le reste est propre à CE restaurant et se remplit dans ce fichier.
# Convention et mise en place : apps/docs/deployment/infisical.md
# ===========================================================================
# --- REQUIS ---
# 32 caractères minimum — openssl rand -base64 32
# Sans elle : sessions non signables, et la réinitialisation de mot de passe
# sort en silence sans envoyer le mail.
BETTER_AUTH_SECRET=

# Dedicated credential for POST /api/email/send, so the mail relay no longer
# shares the session-signing key. Set it on BOTH this env AND the Convex
# deployment: the route authenticates with it and convex/auth.ts presents it.
# Unset, both sides fall back to BETTER_AUTH_SECRET (transitional).
# At least 32 characters. Generate: openssl rand -base64 32
EMAIL_API_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# CONVEX_SITE_URL : NE PAS la mettre ici. Convex la fournit lui-même, et l'API
# refuse qu'on la définisse (« EnvVarNameForbidden: … is built-in and cannot be
# overridden »). Ce fichier la listait, si bien que `pnpm convex:env` mourait
# sur cette ligne — après avoir posé ce qui la précédait. Constaté le
# 2026-09-01 sur un déploiement neuf ; le script la saute désormais et le dit.
# Elle reste nécessaire côté Next (.env.local), où rien ne la fournit.

# --- Admin / URLs de retour ---
# Origine de l'app admin, utilisée pour les redirections après OAuth.
# Sans elle : retour sur http://localhost:3000 depuis la prod.
ADMIN_URL=http://localhost:3000
# Repli pour l'URL des invitations d'équipe quand SITE_URL est absente.
# Sans les deux : les liens pointent sur https://app.beindigital.fr.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret qui permet de réclamer le PREMIER siège super-admin sur un
# déploiement neuf. Échoue FERMÉ : non définie, claimFirstAdmin refuse tout le
# monde et personne ne peut prendre la main sur le back-office.
# Générer : openssl rand -base64 32
ADMIN_BOOTSTRAP_TOKEN=
# Assouplit la vérification d'e-mail de Better Auth (convex/auth.ts). Échoue
# FERMÉ : seule la valeur exacte "true" change quelque chose. Déploiements de
# TEST uniquement — jamais sur un déploiement qui sert un restaurant.
AUTH_ALLOW_UNVERIFIED_EMAIL=false

# --- Encryption (tokens OAuth au repos) — openssl rand -hex 32 ---
ENCRYPTION_KEY=

# --- AWS (uploads S3 + emails SES) ---
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Base publique des liens médias (CDN ou bucket public). Sans elle, les URLs
# construites (CMS, blog, images produit) tapent directement le bucket S3 :
# 403 sur chaque image si le bucket est privé.
AWS_S3_PUBLIC_BASE_URL=
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=
AWS_SES_REPLY_TO_EMAIL=
AWS_SES_CONFIGURATION_SET=

# --- Remontée d'erreurs (Sentry) ---
# Le DSN du projet Sentry DE CE CLIENT — le même que celui utilisé côté
# Next.js. Un projet par client : les erreurs, le quota et la rétention lui
# appartiennent et le suivent s'il part.
#
# `SENTRY_DSN`, et non `NEXT_PUBLIC_SENTRY_DSN` : le préfixe signifie « inclus
# dans le bundle navigateur », et ce magasin de variables n'est jamais lu par
# Next.js. L'ancien nom reste accepté en repli.
#
# Sans elle : les erreurs du backend n'existent que dans les logs de ce
# déploiement. C'est un état pris en charge et sans coût, mais c'est aussi
# celui où une commande qui échoue un samedi soir n'est vue par personne.
#
# Voir apps/docs/deployment/sentry.md
SENTRY_DSN=

# production | preview | development. Sans elle : déduite de NODE_ENV, qu'un
# déploiement de préversion annonce lui aussi comme « production » — les
# erreurs de la préversion remonteraient donc sur la production du client.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# --- OpenAI (traductions automatiques) — ⇢ BeYours ---
OPENAI_API_KEY=

# --- Stripe (paiements restaurant) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# REQUISE dès que les deux identifiants ci-dessus sont posés : le déploiement
# refuse de démarrer sans elle. "true" = bac à sable, "false" = production.
# Absente malgré tout, elle bascule en SANDBOX — jamais en production par
# défaut. convex/paypal.ts la lit ici : c'est ce fichier qui décide sur quel
# hôte PayPal une commande est encaissée.
PAYPAL_SANDBOX_MODE=true

# --- SumUp ---
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=

# --- Uber Eats (app partenaire BeYours) — ⇢ BeYours sauf SANDBOX_MODE ---
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
UBER_EATS_WEBHOOK_SECRET=
# REQUISE dès que les identifiants Uber Eats ci-dessus sont posés : le
# déploiement refuse de démarrer sans elle. "true" = bac à sable, "false" =
# production. Absente malgré tout, elle bascule en SANDBOX — jamais en
# production par défaut.
UBER_EATS_SANDBOX_MODE=true

# --- Uber Direct (livraison à la demande) — ⇢ BeYours ---
# Secret de signature dédié, optionnel : à défaut, uberDirectWebhook.ts
# retombe sur UBER_EATS_WEBHOOK_SECRET puis sur UBER_EATS_CLIENT_SECRET.
# Sans aucun des trois : le webhook répond 503 et le suivi coursier s'arrête.
UBER_DIRECT_WEBHOOK_SECRET=

# --- Deliveroo (app partenaire BeYours) — ⇢ BeYours sauf BRAND_ID/SITE_ID ---
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=
DELIVEROO_BRAND_ID=
DELIVEROO_SITE_ID=
# REQUISE dès que les identifiants Deliveroo ci-dessus sont posés : le
# déploiement refuse de démarrer sans elle. "true" = bac à sable, "false" =
# production. Absente malgré tout, elle bascule en SANDBOX — jamais en
# production par défaut.
DELIVEROO_IS_SANDBOX=true

# --- Unsplash (médias CMS) ---
UNSPLASH_ACCESS_KEY=

# --- Facturation BeYours (Stripe BID) — ⇢ BeYours sauf BID_APP_URL ---
# Ce que BeYours facture AU restaurateur (renouvellement de maintenance).
# Ces actions tournent ici, sur Convex : ces variables n'ont pas d'équivalent
# côté Vercel. Les trois premières vont ensemble (tout ou rien).
# Sans elle : bidSubscription.ts lève « STRIPE_BID_SECRET_KEY non configure ».
STRIPE_BID_SECRET_KEY=
# Sans elle : le webhook de renouvellement est refusé, l'abonnement encaissé
# n'est jamais enregistré.
STRIPE_BID_WEBHOOK_SECRET=
# URL absolue de l'app, pour les redirections de checkout et les liens des
# mails clients. Sans elle : « BID_APP_URL non configure ».
BID_APP_URL=http://localhost:3000
# Price Stripe du renouvellement annuel. Sans lui, « Renouveler en ligne » est
# refusé et le restaurateur est renvoyé vers BeYours.
STRIPE_BID_PRICE_MAINTENANCE=
# Adresse alertée via SES quand un client demande la migration de son site.
# Sans elle, maintenanceEmail.ts journalise et passe : la demande n'arrive
# chez personne — c'est le seul échec vraiment silencieux du lot.
BID_NOTIFY_EMAIL=
