# ===========================================================================
# Variables d'environnement côté CONVEX (fonctions backend)
# ---------------------------------------------------------------------------
# Copier vers .env.convex, remplir uniquement les intégrations actives pour
# ce client, puis appliquer en bulk :
#
#   pnpm convex:env        # = bash scripts/setup-convex-env.sh
#
# .env.convex est gitignoré — ne JAMAIS le commiter.
# Ces variables se lisent/écrivent aussi via `pnpx convex env list|set`.
# ===========================================================================

# --- REQUIS ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Encryption (tokens OAuth au repos) — openssl rand -hex 32 ---
ENCRYPTION_KEY=

# --- AWS (uploads S3 + emails SES) ---
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=
AWS_SES_REPLY_TO_EMAIL=
AWS_SES_CONFIGURATION_SET=

# --- OpenAI (traductions automatiques) ---
OPENAI_API_KEY=

# --- Stripe (paiements restaurant) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- SumUp ---
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=

# --- Uber Eats (app partenaire BeYours) ---
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
UBER_EATS_WEBHOOK_SECRET=
# IMPORTANT : non défini = PRODUCTION. Garder "true" en sandbox.
UBER_EATS_SANDBOX_MODE=true

# --- Deliveroo (app partenaire BeYours) ---
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=
DELIVEROO_BRAND_ID=
DELIVEROO_SITE_ID=
# IMPORTANT : non défini = PRODUCTION. Garder "true" en sandbox.
DELIVEROO_IS_SANDBOX=true

# --- Unsplash (médias CMS) ---
UNSPLASH_ACCESS_KEY=
