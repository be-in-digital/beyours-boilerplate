# ===========================================================================
# BeInDigital Boilerplate - Variables d'environnement
# ===========================================================================
# Ce fichier liste TOUTES les variables utilisees par le boilerplate.
#
# Conventions:
#   [REQUIS]    -> obligatoire pour demarrer l'app
#   [CONVEX]    -> NE PAS mettre dans .env.local. A definir cote Convex via:
#                  pnpx convex env set <NAME> <VALUE>
#   [OPTIONNEL] -> selon les integrations activees pour le client
#
# Pour demarrer un nouveau projet:
#   1. cp .env.example .env.local
#   2. Remplir les sections [REQUIS] (Next.js) ci-dessous
#   3. Pour les sections [CONVEX], voir scripts/setup-convex-env.sh
# ===========================================================================


# ===== CONVEX (cote Next.js) =====================================
# Generes automatiquement par `pnpx convex dev`
NEXT_PUBLIC_CONVEX_URL=                          # [REQUIS]
CONVEX_DEPLOYMENT=                               # [REQUIS]
CONVEX_SITE_URL=                                 # [REQUIS]
NEXT_PUBLIC_CONVEX_SITE_URL=                     # [OPTIONNEL] expose le site URL au client


# ===== BETTER AUTH (cote Next.js) ================================
BETTER_AUTH_URL=http://localhost:3000            # [REQUIS] domaine de l'app
BETTER_AUTH_SECRET=                              # [REQUIS] generer: openssl rand -hex 32


# ===== ADMIN (cote Next.js) ======================================
NEXT_PUBLIC_ADMIN_PAGE_SIZE=15                   # [OPTIONNEL] pagination par defaut
NEXT_PUBLIC_APP_VERSION=                         # [OPTIONNEL] affichee dans le footer admin
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=                 # [OPTIONNEL] autocompletion adresses


# ===== STRIPE CLIENT (cote Next.js) ==============================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=              # [OPTIONNEL] paiements client


# ===== SENTRY (cote Next.js) =====================================
NEXT_PUBLIC_SENTRY_DSN=                          # [OPTIONNEL] monitoring


# ===========================================================================
# Tout ce qui suit doit etre defini cote CONVEX (pas dans .env.local).
# Utiliser:  pnpx convex env set <NAME> <VALUE>
# Ou voir:   scripts/setup-convex-env.sh
# ===========================================================================


# ===== BETTER AUTH (cote Convex) =================================
# BETTER_AUTH_SECRET=                            # [CONVEX][REQUIS] meme valeur qu'au-dessus
# BETTER_AUTH_URL=http://localhost:3000          # [CONVEX][REQUIS] meme valeur qu'au-dessus
# SITE_URL=http://localhost:3000                 # [CONVEX][REQUIS] domaine de l'app


# ===== AWS S3 / SES (cote Convex) ================================
# AWS_REGION=eu-west-1                           # [CONVEX] uploads + emails
# AWS_ACCESS_KEY_ID=                             # [CONVEX]
# AWS_SECRET_ACCESS_KEY=                         # [CONVEX]
# AWS_S3_BUCKET_NAME=                            # [CONVEX] uploads images/medias
# AWS_SES_FROM_EMAIL=                            # [CONVEX] emails transactionnels


# ===== OPENAI (cote Convex) ======================================
# OPENAI_API_KEY=                                # [CONVEX] traduction automatique


# ===== ENCRYPTION (cote Convex) ==================================
# ENCRYPTION_KEY=                                # [CONVEX] chiffrement credentials POS
                                                 # generer: openssl rand -hex 32


# ===== STRIPE - SaaS BeInDigital (cote Convex) ===================
# STRIPE_BID_SECRET_KEY=                         # [CONVEX] subscription du SaaS
# STRIPE_BID_WEBHOOK_SECRET=                     # [CONVEX]
# STRIPE_BID_PRICE_STARTER=                      # [CONVEX] price IDs Stripe
# STRIPE_BID_PRICE_PRO=                          # [CONVEX]
# STRIPE_BID_PRICE_ENTERPRISE=                   # [CONVEX]
# STRIPE_BID_PRICE_STARTER_ANNUAL=               # [CONVEX]
# STRIPE_BID_PRICE_PRO_ANNUAL=                   # [CONVEX]
# STRIPE_BID_PRICE_ENTERPRISE_ANNUAL=            # [CONVEX]
# BID_APP_URL=                                   # [CONVEX] URL de l'app SaaS BID


# ===== STRIPE - Restaurant (cote Convex) =========================
# STRIPE_SECRET_KEY=                             # [CONVEX] paiements restaurants
# STRIPE_WEBHOOK_SECRET=                         # [CONVEX]
# STRIPE_PRICE_STARTER=                          # [CONVEX]
# STRIPE_PRICE_PRO=                              # [CONVEX]
# STRIPE_PRICE_BUSINESS=                         # [CONVEX]
# STRIPE_PRICE_STARTER_YEARLY=                   # [CONVEX]
# STRIPE_PRICE_PRO_YEARLY=                       # [CONVEX]
# STRIPE_PRICE_BUSINESS_YEARLY=                  # [CONVEX]


# ===== PAYPAL (cote Convex) ======================================
# PAYPAL_CLIENT_ID=                              # [CONVEX]
# PAYPAL_CLIENT_SECRET=                          # [CONVEX]


# ===== UBER EATS (cote Convex) ===================================
# UBER_EATS_CLIENT_ID=                           # [CONVEX] integration livraison
