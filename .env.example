# ============================================
# BeInDigital Boilerplate - Environment Variables
# ============================================
# Copiez ce fichier vers .env.local et remplissez les valeurs.
# Les variables avec [REQUIS] doivent etre definies pour que l'app demarre.

# --- Convex [REQUIS] ---
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=
# Optionnel : expose le site URL cote client si vous appelez des HTTP actions depuis le navigateur
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Better Auth [REQUIS] ---
# URL de l'app (ex: http://localhost:3000 en dev, https://votre-domaine.com en prod)
BETTER_AUTH_URL=http://localhost:3000
# Generer avec : openssl rand -hex 32
BETTER_AUTH_SECRET=

# --- Google Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- AWS S3 [REQUIS pour upload d'images] ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# --- AWS SES (Email transactionnel) ---
AWS_SES_FROM_EMAIL=

# --- OpenAI (Traduction automatique) ---
OPENAI_API_KEY=

# --- Paiements ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SUMUP_API_KEY=
PAYPAL_CLIENT_ID=
SQUARE_ACCESS_TOKEN=

# --- Integrations tierces ---
UBER_EATS_API_KEY=
DELIVEROO_API_KEY=
UBER_DIRECT_CUSTOMER_ID=

# --- Sentry (Monitoring) ---
NEXT_PUBLIC_SENTRY_DSN=
