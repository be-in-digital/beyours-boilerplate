# =============================================================================
# BeYours Restaurant — environment template
# =============================================================================
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#   cp .env.example .env.local        (fait automatiquement par `pnpm setup`)
#
# Validation lives in @be-in-digital/core src/env/schemas.ts (Zod) and runs at
# startup from instrumentation.ts. Three tiers:
#
#   REQUIRED  The 7 variables marked "# REQUIRED --" below. The deployment does
#             not boot without them. An EMPTY value no longer passes: copying
#             this template and leaving one blank now fails exactly like
#             deleting the line. Each one used to fail silently in front of the
#             restaurant owner instead.
#   OPTIONAL  Everything else. Left unset (or empty), the matching feature is
#             simply off.
#   FEATURE   All-or-nothing groups: Stripe, PayPal, SumUp, BeYours billing.
#             Set ONE variable of a group and the whole group becomes required.
#             Half a payment provider is worse than none -- the admin offers the
#             method and the charge fails at the till. See SITE_FEATURE_GROUPS
#             in the schema.
#
# Secrets must come from here / GitHub Secrets, never hardcoded in source.
# =============================================================================

# --- Convex (per restaurant) -------------------------------------------------
# REQUIRED -- no backend at all: every query hangs.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Client-side twin of CONVEX_SITE_URL. Must stay paired with
# NEXT_PUBLIC_CONVEX_URL (same subdomain).
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# REQUIRED -- webhook and OAuth callback URLs point nowhere without it.
CONVEX_SITE_URL=https://your-deployment.convex.site
CONVEX_DEPLOYMENT=dev:your-deployment

# --- Auth (Better Auth) ------------------------------------------------------
# REQUIRED -- at least 32 characters. Sessions are unsignable without it, and
# password reset returns early so the mail is never sent.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Dedicated credential for POST /api/email/send, so the mail relay no longer
# shares the session-signing key. Set it on BOTH this env AND the Convex
# deployment: the route authenticates with it and convex/auth.ts presents it.
# Unset, both sides fall back to BETTER_AUTH_SECRET (transitional).
# At least 32 characters. Generate: openssl rand -base64 32
EMAIL_API_SECRET=
# REQUIRED -- same early return as above: no password reset mail leaves.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Admin app origin used for OAuth callback redirects (Uber Eats connect, etc.)
ADMIN_URL=http://localhost:3000

# Relaxes Better Auth's email verification (convex/auth.ts). Fails CLOSED: only
# the exact value "true" relaxes anything, so unset or mistyped keeps
# verification ON. TEST deployments only -- the e2e suite signs in as a seeded
# account with no mailbox. Never on a deployment a restaurant is served from.
AUTH_ALLOW_UNVERIFIED_EMAIL=false

# Secret required to claim the FIRST super-admin seat on a fresh deployment.
# Set it on the CONVEX deployment (not just here), hand it to whoever sets the
# restaurant up, and drop it once the seat is taken.
# Sign-up is open on the storefront, so without this the first authenticated
# visitor could take the whole deployment. Leaving it unset refuses everyone —
# deliberately: it must never fail open.
# Generate: openssl rand -base64 32
ADMIN_BOOTSTRAP_TOKEN=

# --- Encryption (OAuth tokens at rest) ---------------------------------------
# REQUIRED -- OAuth tokens cannot be stored at rest without it.
# 32-byte key as 64 hex chars. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# --- AWS S3 (per-restaurant bucket) ------------------------------------------
# REQUIRED -- no upload target. The bucket is PRIVATE: block all public access,
# attach no policy granting s3:GetObject to *. See
# apps/docs/deployment/s3-bucket-policy.md.
AWS_S3_BUCKET_NAME=
# Optional. Origin of a CDN fronting the bucket (CloudFront + origin access
# control), e.g. https://cdn.your-site.example -- no trailing slash. Leave empty
# and media is served by this app's own /api/files proxy.
AWS_S3_PUBLIC_BASE_URL=

# --- AWS SES (per-restaurant sending) ----------------------------------------
# REQUIRED -- no transactional mail leaves the deployment.
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=
AWS_SES_REPLY_TO_EMAIL=
AWS_SES_CONFIGURATION_SET=

# --- Monitoring / Maps (per client) ------------------------------------------
# One Sentry PROJECT per client: its errors, its quota and its retention stay
# its own, and follow it if it leaves. Create it, copy the DSN here, and error
# reporting turns itself on. Leave it empty and Sentry never initialises.
# Full procedure: apps/docs/deployment/sentry.md
NEXT_PUBLIC_SENTRY_DSN=
# Optional. Unset, Vercel's own VERCEL_ENV already keeps preview deploys out of
# the production issue list. Set it on any other host.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional. Unset, the git commit sha of the deployment is used.
NEXT_PUBLIC_SENTRY_RELEASE=
# Optional, 0 to 1. Defaults to 0.1 in production — a busy Saturday at 1.0
# spends the free-tier quota on traces and Sentry then drops the errors.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Source-map upload, read at BUILD time. All three or none: half of this
# uploads nothing and every production stack trace stays minified.
# The token is a secret — set it on the build host, never in a NEXT_PUBLIC_ var.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Payments (per restaurant) -----------------------------------------------
# All-or-nothing per provider: Stripe needs SECRET + WEBHOOK together, PayPal
# and SumUp need both of their ids. Configure a provider fully or not at all.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# IMPORTANT: when UNSET this defaults to PRODUCTION. Keep "true" for sandbox.
PAYPAL_SANDBOX_MODE=true
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=

# --- CMS media ---------------------------------------------------------------
UNSPLASH_ACCESS_KEY=

# --- Contact -----------------------------------------------------------------
# Public contact address surfaced in the app.
CONTACT_EMAIL=
# Optional mailto shown as "Contacter BeYours" in the renewal CTA. Unset, the
# admin shows a neutral message instead of a link.
NEXT_PUBLIC_BID_SUPPORT_EMAIL=

# =============================================================================
# BeYours platform credentials (shared infra — see packages/core/.env.example)
# For LOCAL dev the app process reads these from this file too.
# =============================================================================

# --- AWS (BeYours account) -----------------------------------------------
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- OpenAI (translations) ---------------------------------------------------
OPENAI_API_KEY=sk-...

# --- BeYours billing (Stripe BID) --------------------------------------------
# Subscriptions billed BY BeYours TO the restaurant owner (autoBlog plans,
# annual maintenance renewal). Set these on the CONVEX deployment
# (`pnpm dlx convex env set ...`) — the webhook and checkout actions run there.
STRIPE_BID_SECRET_KEY=sk_test_...
STRIPE_BID_WEBHOOK_SECRET=whsec_...
# Absolute URL of the deployed app, used for checkout redirect URLs
BID_APP_URL=http://localhost:3000
# Stripe price for the annual maintenance renewal. Without it, convex/
# bidSubscription.ts refuses the renewal and the owner is told to contact
# BeYours — "Renouveler en ligne" cannot work.
STRIPE_BID_PRICE_MAINTENANCE=
# Address alerted via SES when a client asks to migrate their site away.
# Without it convex/maintenanceEmail.ts logs and moves on, so the request
# reaches nobody: this one fails silently.
BID_NOTIFY_EMAIL=

# --- Uber Eats (BeYours partner app) -------------------------------------
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
# Optional dedicated webhook signing secret. If unset, the client secret is used
# (Uber Eats signs webhooks with the client secret).
UBER_EATS_WEBHOOK_SECRET=
# IMPORTANT: when UNSET this defaults to PRODUCTION. Keep "true" for sandbox.
UBER_EATS_SANDBOX_MODE=true

# --- Uber Direct (BeYours partner app) -----------------------------------
# Uber Direct rides on the Uber Eats credentials above. Optional dedicated
# webhook signing secret: if unset, convex/uberDirectWebhook.ts falls back to
# UBER_EATS_WEBHOOK_SECRET, then to UBER_EATS_CLIENT_SECRET. With none of the
# three set, the courier status webhook answers 503 and orders stop tracking.
UBER_DIRECT_WEBHOOK_SECRET=

# --- Deliveroo (BeYours partner app) -------------------------------------
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=
DELIVEROO_BRAND_ID=
DELIVEROO_SITE_ID=
# IMPORTANT: when UNSET this defaults to PRODUCTION. Keep "true" for sandbox.
DELIVEROO_IS_SANDBOX=true

# =============================================================================
# Local dev / tooling (not used in production)
# =============================================================================
# Password for `tsx scripts/seed-users.mts` test accounts. Test only.
SEED_PASSWORD=
# Enables the /(test) routes. Keep unset/false outside local dev.
NEXT_PUBLIC_ENABLE_TEST_ROUTES=false
# Path to a local engine checkout, used by `pnpm engine:link` and the
# site-creation scripts.
BID_ENGINE_PATH=
# GitHub Packages PAT (read:packages) required by `pnpm install` for the
# private @be-in-digital/* packages. Prefer your shell env / .npmrc over
# storing it here.
NODE_AUTH_TOKEN=
# Set to "true" to skip the NODE_AUTH_TOKEN preflight check in the scripts
# (e.g. when using `pnpm engine:link` instead of the registry).
SKIP_NODE_AUTH_TOKEN_CHECK=
