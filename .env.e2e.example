# ==============================================================================
# End-to-end test environment
# ==============================================================================
#
# Copy to `.env.e2e` (git-ignored) and fill it in, or export these in your shell
# before running `pnpm test:e2e`.
#
# TWO PLACES, NOT ONE. Variables read by a Convex FUNCTION must be set on the
# Convex deployment (`npx convex env set NAME value`); a Convex function does
# not see this file. Variables read by Next.js or by the test runner belong
# here. The list below says which is which.
#
# Point every one of these at a deployment you are willing to see wiped. The
# seed script creates accounts and the suite writes orders, products and team
# members.
# ==============================================================================

# --- Read by the test runner and by Next.js (this file) -----------------------

# Written by `npx convex dev` into .env.local. Repeated here only if you run the
# suite against a DIFFERENT deployment than your day-to-day one.
# The suite decides whether to run its admin tests by looking at this value: a
# URL containing "placeholder" runs the public tests only.
NEXT_PUBLIC_CONVEX_URL=

# The HTTP origin of the same deployment (…convex.site, not …convex.cloud).
# Used by the Deliveroo webhook tests.
CONVEX_SITE_URL=

BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Password given to every seeded test account. `scripts/seed-users.mts` writes
# it and `e2e/auth.setup.ts` signs in with it — the two MUST match, and neither
# hardcodes it. Throwaway value; never a real password.
SEED_PASSWORD=

# --- Read by Convex functions: set with `npx convex env set` ------------------
# Listed here so nothing is forgotten. Putting them in this file alone has no
# effect on the backend.
#
#   npx convex env set BETTER_AUTH_SECRET   "$(openssl rand -base64 32)"
#   npx convex env set ENCRYPTION_KEY       "$(openssl rand -hex 32)"
#   npx convex env set SITE_URL             http://localhost:3000
#
# ENCRYPTION_KEY must be exactly 64 hex characters: it is the AES-256-GCM key
# protecting the payment-provider tokens in `paymentConnections`.
#
# REQUIRED to boot a PRODUCTION server, even with placeholder values.
#
# `instrumentation.ts` validates these at startup and refuses to start without
# them — `next start` dies with "N environment variable(s) à corriger" before
# serving a single request. A dev server reports and carries on, which is why
# this only surfaces when running the suite against a build.
#
# The site tier below grew when the schema was split into required / optional /
# feature-gated tiers: leaving one of the three S3/SES/URL lines out now stops
# the server, where before it only broke the matching feature in front of a
# restaurant owner. `.github/workflows/e2e.yml` carries the same placeholders.
#
# Placeholders are enough for every test that does not actually reach S3, SES
# or OpenAI, which is all of them today. Real values only if you add tests that
# do.
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
OPENAI_API_KEY=sk-placeholder

# Site tier, also required to boot a build. Never reached by today's tests.
# AWS_S3_PUBLIC_BASE_URL is deliberately absent: unset means media is served by
# the app's own /api/files proxy, which is what the suite exercises.
AWS_S3_BUCKET_NAME=placeholder-bucket
AWS_SES_FROM_EMAIL=e2e@placeholder.invalid

# Optional, only for the suites that skip themselves without them:
#   DELIVEROO_CLIENT_ID / DELIVEROO_CLIENT_SECRET
#   DELIVEROO_WEBHOOK_SECRET / DELIVEROO_SITE_ID / DELIVEROO_BRAND_ID
