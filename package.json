{
  "name": "beyours-boilerplate",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-auth-token.mjs",
    "setup": "node scripts/init.mjs",
    "add:mobile": "node scripts/add-mobile.mjs",
    "create:site": "node scripts/create-site.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "type-check": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install --with-deps chromium",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen",
    "convex:env": "bash scripts/setup-convex-env.sh",
    "convex:env:infisical": "bash scripts/setup-convex-env.sh --infisical",
    "ses:check": "bash scripts/check-ses-status.sh",
    "env:setup": "node scripts/env.mjs setup",
    "env:check": "node scripts/env.mjs check",
    "env:sync": "node scripts/env.mjs sync",
    "template:list": "node scripts/apply-template.mjs list",
    "template:apply": "node scripts/apply-template.mjs apply",
    "update:engine": "node scripts/update-engine.mjs",
    "update:template": "node scripts/update-template.mjs",
    "engine:link": "node scripts/engine-link.mjs link",
    "engine:unlink": "node scripts/engine-link.mjs unlink",
    "clean": "rm -rf .next node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/client-sesv2": "^3.1024.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@be-in-digital/admin": "^8.0.0",
    "@be-in-digital/cms": "^3.0.0",
    "@be-in-digital/convex-functions": "^3.0.0",
    "@be-in-digital/convex-schema": "^3.0.0",
    "@be-in-digital/core": "^2.3.0",
    "@be-in-digital/integrations": "^2.1.0",
    "@be-in-digital/marketing": "^2.1.0",
    "@be-in-digital/restaurant": "^2.1.0",
    "@be-in-digital/ui": "^2.0.3",
    "@convex-dev/better-auth": "^0.12.5",
    "@hookform/resolvers": "^5.2.2",
    "@sentry/nextjs": "^10.71.0",
    "@tiptap/core": "^3.22.2",
    "@tiptap/extension-blockquote": "^3.22.2",
    "@tiptap/extension-bold": "^3.22.2",
    "@tiptap/extension-bubble-menu": "^3.22.2",
    "@tiptap/extension-character-count": "^3.22.2",
    "@tiptap/extension-code": "^3.22.2",
    "@tiptap/extension-code-block": "^3.22.2",
    "@tiptap/extension-document": "^3.22.2",
    "@tiptap/extension-floating-menu": "^3.22.2",
    "@tiptap/extension-hard-break": "^3.22.2",
    "@tiptap/extension-heading": "^3.22.2",
    "@tiptap/extension-horizontal-rule": "^3.22.2",
    "@tiptap/extension-image": "^3.22.2",
    "@tiptap/extension-italic": "^3.22.2",
    "@tiptap/extension-link": "^3.22.2",
    "@tiptap/extension-list": "^3.22.2",
    "@tiptap/extension-paragraph": "^3.22.2",
    "@tiptap/extension-placeholder": "^3.22.2",
    "@tiptap/extension-strike": "^3.22.2",
    "@tiptap/extension-text": "^3.22.2",
    "@tiptap/extension-underline": "^3.22.2",
    "@tiptap/extensions": "^3.22.2",
    "@tiptap/pm": "^3.22.2",
    "@tiptap/react": "^3.22.2",
    "@tiptap/starter-kit": "^3.22.2",
    "better-auth": "1.6.17",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "convex": "1.44.0",
    "convex-helpers": "0.1.112",
    "framer-motion": "^12.38.0",
    "isomorphic-dompurify": "^3.7.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "convex-test": "^0.0.44",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.12",
    "jsdom": "28.1.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-arm64": "1.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "eslint-plugin-react-hooks": "7.0.1"
    }
  }
}
