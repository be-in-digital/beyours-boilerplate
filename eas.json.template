{
  "_comment": "Template for Expo Application Services (EAS) config. Renamed to eas.json by scripts/init.js when mobile is enabled. Required EAS secrets: NODE_AUTH_TOKEN (read:packages PAT for @be-in-digital/* private packages). Set via: eas secret:create --scope project --name NODE_AUTH_TOKEN --value <token>",
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "$EXPO_PUBLIC_CONVEX_URL"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "$EXPO_PUBLIC_CONVEX_URL"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "$EXPO_PUBLIC_CONVEX_URL"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
